^SAMPLE = GSM3717983
!Sample_title = BulkRNA-seq_murine_p12_DPP4_Rep1
!Sample_geo_accession = GSM3717983
!Sample_status = Public on May 01 2019
!Sample_submission_date = Apr 11 2019
!Sample_last_update_date = May 01 2019
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Subcutaneous WAT (inguinal + axillary)
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = strain: C57BL/6
!Sample_characteristics_ch1 = age: 12 days
!Sample_characteristics_ch1 = gender: Mixed male and female
!Sample_characteristics_ch1 = tissue: Inguinal + Axillary White Adipose
!Sample_characteristics_ch1 = cell population: DPP4+
!Sample_characteristics_ch1 = developmental stage: p12
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Whole adipose tissues were manually minced, digested with Collagenase D and Dispase II at 37C for 45 min, and cells were separated into DPP4+, ICAM1+, and CD142+ Populations via FACS. FACS isolated cells were pelleted via centrifugation and lysed in TriZol reagent followed by phenol cholorform extraction/ arctus picopure RNA isolation kit to isolate RNA.
!Sample_extract_protocol_ch1 = Novogene Paired End Protocol "fter the QC procedures, mRNA from eukaryotic organisms is enriched using oligo(dT) beads. For prokaryotic organisms or eukaryotic organisms' long-non-coding libraries, rRNA is removed using the Ribo-Zero kit that leaves the mRNA. First, the mRNA is fragmented randomly by adding fragmentation buffer, then the cDNA is synthesized by using mRNA template and random hexamers primer, after which a custom second-strand synthesis buffer (Illumina) , dNTPs, RNase H and DNA polymerase I are added to initiate the second-strand synthesis. Second, after a series of terminal repair, A ligation and sequencing adaptor ligation, the double-stranded cDNA library is completed through size selection and PCR enrichment."
!Sample_description = Bulk RNA-Seq of FACS purified DPP4+ cells
!Sample_description = processed data in files: ResultsCD142vDPP4.csv, ResultsICAM1vDPP4.csv
!Sample_data_processing = Illumina Casava1.7 software used for basecalling.
!Sample_data_processing = Sequenced reads were mapped to mm10 whole genome using STAR v2.5.2a with parameters --outFilterMultimapNmax 1 --quantmode Genecounts
!Sample_data_processing = Raw genecounts were analyzed for differential expression via DeSeq2 in R 3.5.1
!Sample_data_processing = Genome_build: mm10
!Sample_data_processing = Supplementary_files_format_and_content: DESeq2 analysis of differential expression in all pairwise comparisons of DPP4+, ICAM1+, and CD142+ cells.
!Sample_platform_id = GPL21273
